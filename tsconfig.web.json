{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/renderer/components/**/*",
    "src/renderer/hooks/**/*",
    "src/renderer/utils/**/*",
    "src/renderer/types.ts",
    "src/main/**/*",
    "src/preload/*.d.ts",
    "tests/renderer/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ]
    },
    "types": ["@testing-library/jest-dom"]
  }
}
